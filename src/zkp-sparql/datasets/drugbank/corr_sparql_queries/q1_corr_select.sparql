PREFIX drugbank: <http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugbank/> 
PREFIX drugtype: <http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugtype/>
PREFIX kegg: <http://bio2rdf.org/ns/kegg#>
PREFIX chebi: <http://bio2rdf.org/ns/bio2rdf#>
PREFIX purl: <http://purl.org/dc/elements/1.1/>

SELECT DISTINCT ?drug ?drugDesc ?compound ?ReactionTitle ?ChemicalEquation
WHERE {
  {
    SELECT DISTINCT ?drug ?compound
    WHERE {
      ?drug drugbank:drugType drugtype:smallMolecule .
      ?drug drugbank:keggCompoundId ?compound .
    }
  }

  {
    SELECT ?drugDesc
    WHERE {
      ?drug drugbank:description ?drugDesc .
    }
  }

  OPTIONAL {
    {
      SELECT ?molecularWeightAverage
      WHERE {
        ?drug drugbank:molecularWeightAverage ?molecularWeightAverage .
        FILTER (?molecularWeightAverage > 114)
      }
    }
  }

  # You mention ?ReactionTitle and ?ChemicalEquation in SELECT but they are unused
  # You can correlate more deeply if those properties exist, e.g.:
  OPTIONAL {
    ?drug drugbank:reaction ?reaction .
    ?reaction drugbank:reactionTitle ?ReactionTitle .
    ?reaction drugbank:chemicalEquation ?ChemicalEquation .
  }
}
LIMIT 1000
