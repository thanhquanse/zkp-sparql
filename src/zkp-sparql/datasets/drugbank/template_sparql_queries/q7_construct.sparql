PREFIX drugbank: <http://www4.wiwiss.fu-berlin.de/drugbank/resource/drugbank/>

CONSTRUCT {
  ?drug drugbank:chemicalFormula ?formula ;
        drugbank:chemicalIupacName ?iupac ;
        drugbank:structure ?structure ;
        drugbank:keggCompoundId ?keggID .
}
WHERE {
  ?drug drugbank:chemicalFormula ?formula .
  OPTIONAL { ?drug drugbank:chemicalIupacName ?iupac . }
  OPTIONAL { ?drug drugbank:structure ?structure . }
  OPTIONAL { ?drug drugbank:keggCompoundId ?keggID . }
}
LIMIT 50
