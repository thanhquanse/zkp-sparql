PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX swrc: <http://swrc.ontoware.org/ontology#>

SELECT DISTINCT ?author (COUNT(?paper) AS ?numPapers)
WHERE {
  {
    ?event a <http://data.semanticweb.org/ns/swc/ontology#TalkEvent> ;
           <http://www.w3.org/2000/01/rdf-schema#label> ?label ;
           <http://data.semanticweb.org/ns/swc/ontology#hasRelatedDocument> ?paper .
    FILTER(REGEX(?label, "da", "i"))
    ?paper <http://xmlns.com/foaf/0.1/maker> ?author .
    OPTIONAL { ?paper swrc:year ?year . }
  }
  UNION
  {
    ?event <http://data.semanticweb.org/ns/swc/ontology#hasRelatedDocument> ?paper .
    ?paper <http://xmlns.com/foaf/0.1/maker> ?author .
    FILTER(REGEX(?author, "a", "i"))
  }
  MINUS {
    ?paper rdfs:label "OPTIMA:  A System for Semi Automatic and Large Scale Ontology Population" .
  }
}
GROUP BY ?author
ORDER BY DESC(?numPapers)
LIMIT 1000
OFFSET 0
