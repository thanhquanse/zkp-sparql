SELECT ?product ?label ?rating
WHERE {
  GRAPH <http://bsbm.org/graphs/products> {
    ?product a <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/Product> ;
             <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/label> ?label .
  }
  GRAPH <http://bsbm.org/graphs/reviews> {
    ?review <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/reviewFor> ?product ;
            <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/rating> ?rating .
  }
}
