PREFIX bsbm-inst: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/instances/>
PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT DISTINCT ?product ?label ?propertyTextual (COUNT(DISTINCT ?label) AS ?numLabel)
WHERE {
    { 
        ?product rdfs:label ?label .
        ?product rdf:type bsbm-inst:ProductType2 .
        ?product bsbm:productPropertyTextual1 ?propertyTextual .
        ?product bsbm:productPropertyNumeric1 ?p1 .
        OPTIONAL {
            ?product rdfs:label ?label .
            ?product rdf:type bsbm-inst:ProductType3 .
            ?product bsbm:productPropertyTextual1 ?propertyTextual .
            ?product bsbm:productPropertyNumeric1 ?p1 .
        }
        FILTER ( ?p1 > 5 )
    } 
    UNION 
    {
        ?product rdfs:label ?label .
        ?product rdf:type bsbm-inst:ProductType10 .
        ?product bsbm:productPropertyTextual1 ?propertyTextual .
        ?product bsbm:productPropertyNumeric2 ?p2 .
        FILTER ( ?p2 > 10 ) 
    }
    MINUS {
        ?product rdf:type bsbm-inst:ProductType4 .
    }
}
GROUP BY ?label
ORDER BY ?label
OFFSET 0
LIMIT 1000