@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix ex: <http://example.org/tpch#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#LineItemMapping>
    rml:logicalSource [
        rml:source "lineitem.tbl" ;
        rml:referenceFormulation ql:CSV ;
        rml:delimiter "|" ;
    ] ;

    rr:subjectMap [
        rr:template "http://example.org/tpch/lineitem/{l_orderkey}/{l_linenumber}" ;
        rr:class ex:LineItem ;
    ] ;

    rr:predicateObjectMap [
        rr:predicate ex:orderKey ;
        rr:objectMap [ rml:reference "l_orderkey" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:partKey ;
        rr:objectMap [ rml:reference "l_partkey" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:supplierKey ;
        rr:objectMap [ rml:reference "l_suppkey" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:lineNumber ;
        rr:objectMap [ rml:reference "l_linenumber" ; rr:datatype xsd:integer ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:quantity ;
        rr:objectMap [ rml:reference "l_quantity" ; rr:datatype xsd:decimal ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:extendedPrice ;
        rr:objectMap [ rml:reference "l_extendedprice" ; rr:datatype xsd:decimal ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:discount ;
        rr:objectMap [ rml:reference "l_discount" ; rr:datatype xsd:decimal ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:tax ;
        rr:objectMap [ rml:reference "l_tax" ; rr:datatype xsd:decimal ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:returnFlag ;
        rr:objectMap [ rml:reference "l_returnflag" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:lineStatus ;
        rr:objectMap [ rml:reference "l_linestatus" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:shipDate ;
        rr:objectMap [ rml:reference "l_shipdate" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:commitDate ;
        rr:objectMap [ rml:reference "l_commitdate" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:receiptDate ;
        rr:objectMap [ rml:reference "l_receiptdate" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:shipInstruct ;
        rr:objectMap [ rml:reference "l_shipinstruct" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:shipMode ;
        rr:objectMap [ rml:reference "l_shipmode" ; rr:datatype xsd:string ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate ex:comment ;
        rr:objectMap [ rml:reference "l_comment" ; rr:datatype xsd:string ] ;
    ] .